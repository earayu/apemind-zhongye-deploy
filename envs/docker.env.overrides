# Docker Compose host overrides — K8s 标准交付形态对齐
#
# 版本基线（v2.3.37，对标新加坡生产环境）：
#   PostgreSQL 16（元数据）+ PostgreSQL 16（graph）
#   Qdrant 1.15.4 / Redis 7.4.7 / ES 8.15.5 / MinIO 2024-11-07
#
# ⚠️ 此文件的所有 URL 含明文密码，供本地 dev/compose 使用；
#    不要把这些凭据当成生产值。

# === 主机名覆盖（替换 .env 里的 localhost 默认值）===
POSTGRES_HOST=apemind-postgres
POSTGRES_DB=aperag
REDIS_HOST=apemind-redis
ES_HOST_NAME=apemind-es

# === 元数据 PG（metadata）===
DATABASE_URL="postgresql://postgres:postgres@apemind-postgres:5432/aperag"
PGVECTOR_DATABASE_URL="postgresql://postgres:postgres@apemind-postgres:5432/aperag"

# === 图数据 PG（graph，独立 service，对标 K8s pg-cluster-graph）===
GRAPH_DB_TYPE=postgresql
GRAPH_DATABASE_URL="postgresql://postgres:postgres@apemind-postgres-graph:5432/aperag_graph"

# === Qdrant ===
QDRANT_URL=http://apemind-qdrant
QDRANT_PORT=6333
QDRANT_DISTANCE=Cosine
QDRANT_TIMEOUT_SECONDS=1000

# === Elasticsearch ===
ES_HOST=http://apemind-es:9200

# === Redis（4 个 URL 对应 db=1/2/3/4，各自隔离）===
MEMORY_REDIS_URL=redis://default:password@apemind-redis:6379/1
INDEXING_QUEUE_BACKEND=redis
INDEXING_QUEUE_REDIS_URL=redis://default:password@apemind-redis:6379/2
# INDEXING_QUOTA_* drives the per-modality LLM cap backend
INDEXING_QUOTA_BACKEND=redis
INDEXING_QUOTA_REDIS_URL=redis://default:password@apemind-redis:6379/3
CACHE_REDIS_URL=redis://default:password@apemind-redis:6379/4

# === MinIO 对象存储（对标 K8s minio-cluster）===
OBJECT_STORE_TYPE=s3
OBJECT_STORE_S3_ENDPOINT=http://apemind-minio:9000
OBJECT_STORE_S3_ACCESS_KEY=minioadmin
OBJECT_STORE_S3_SECRET_KEY=minioadmin
OBJECT_STORE_S3_BUCKET=aperag
OBJECT_STORE_S3_USE_PATH_STYLE=True
OBJECT_STORE_S3_REGION=

# === 数据库连接池（Docker 形态参数）===
DB_POOL_SIZE=25
DB_POOL_MAX_OVERFLOW=50
DB_POOL_TIMEOUT=60
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=True

# === 路径 ===
TIKTOKEN_CACHE_DIR=/root/.cache/tiktoken

# === 可观测性（默认关闭，按需打开）===
# APERAG_OBSERVABILITY_MODE=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://your-otel-endpoint:4318

# === 图谱索引开关 ===
# 开启后 reconciler 会处理 graph_vectors 等图谱类索引任务。
# v2.3.x 读取 APEMIND_DOC_GRAPH_ENABLED；中冶部署已配置 graph PG + Qdrant，需要显式开启。
APEMIND_DOC_GRAPH_ENABLED=True

# === K8s-only 功能在 compose 下的说明 ===
# audit log 自动清理（K8s CronJob）在 compose 下不会自动运行，不影响应用。
# 如需手动清理：
#   docker compose exec apemind-postgres psql -U postgres -d aperag \
#     -c "DELETE FROM audit_log WHERE created_at < NOW() - INTERVAL '90 days';"

# Agent-turn 孤儿 reaper（v2.3.31 起可用，本部署继续启用）：进程重启（升级/改配置/故障处置）会把
# 在途对话 turn 变成永远 RUNNING 的孤儿，前端表现为聊天卡死。reaper 挂在 indexing
# worker 的 reconcile 循环上自动收尸。compose 部署默认 off（enterprise#1759），
# 福州 POC 2026-06-12 升级窗口已实测生效（重启产生 1 个孤儿、首个周期收掉）。
APEMIND_AGENT_TURN_REAPER_MODE=live
